{
  "name": "Catppuccin VHDL Frappe",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#303446",
    "editor.foreground": "#c6d0f5",
    "editorCursor.foreground": "#c6d0f5",
    "editor.selectionBackground": "#51576d",
    "editor.lineHighlightBackground": "#414559",
    "editorLineNumber.foreground": "#51576d",
    "editorLineNumber.activeForeground": "#ca9ee6",
    "editorWhitespace.foreground": "#414559",
    "editorIndentGuide.background1": "#414559",
    "editorIndentGuide.activeBackground1": "#51576d",
    "editorBracketMatch.background": "#51576d",
    "editorBracketMatch.border": "#ca9ee6",
    "editorError.foreground": "#e78284",
    "editorWarning.foreground": "#e5c890",
    "editorInfo.foreground": "#99d1db",
    "editorHint.foreground": "#838ba7",
    "editorGutter.addedBackground": "#a6d189",
    "editorGutter.modifiedBackground": "#e5c890",
    "editorGutter.deletedBackground": "#e78284",
    "editorSuggestWidget.background": "#292c3c",
    "editorSuggestWidget.selectedBackground": "#51576d",
    "editorHoverWidget.background": "#292c3c",
    "editorWidget.background": "#292c3c",
    "sideBar.background": "#292c3c",
    "sideBarSectionHeader.background": "#303446",
    "activityBar.background": "#292c3c",
    "activityBar.foreground": "#c6d0f5",
    "statusBar.background": "#292c3c",
    "statusBar.foreground": "#c6d0f5",
    "titleBar.activeBackground": "#292c3c",
    "titleBar.activeForeground": "#c6d0f5",
    "tab.activeBackground": "#303446",
    "tab.inactiveBackground": "#292c3c",
    "tab.activeBorderTop": "#ca9ee6",
    "panel.background": "#303446",
    "terminal.background": "#303446",
    "terminal.foreground": "#c6d0f5",
    "list.activeSelectionBackground": "#51576d",
    "list.hoverBackground": "#414559",
    "input.background": "#292c3c",
    "dropdown.background": "#292c3c",
    "focusBorder": "#ca9ee6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#949cbb",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#f4b8e4"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#ef9f76"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#99d1db"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#99d1db"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#ef9f76",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#c6d0f5",
    "variable.readonly": "#ef9f76",
    "parameter": {
      "foreground": "#ea999c",
      "fontStyle": "italic"
    },
    "property": "#babbf1",
    "enumMember": "#ef9f76",
    "function": "#8caaee",
    "type": {
      "foreground": "#e5c890",
      "fontStyle": "italic"
    },
    "class": "#e5c890",
    "namespace": "#e5c890",
    "struct": {
      "foreground": "#e5c890",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#e5c890",
      "fontStyle": "italic"
    },
    "operator": "#99d1db"
  }
}
