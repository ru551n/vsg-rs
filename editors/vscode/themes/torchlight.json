{
  "name": "Torchlight VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1e1d1d",
    "editor.foreground": "#e3ca9a",
    "editorCursor.foreground": "#e3ca9a",
    "editor.selectionBackground": "#393830",
    "editor.lineHighlightBackground": "#212120",
    "editorLineNumber.foreground": "#575547",
    "editorLineNumber.activeForeground": "#e3a138",
    "editorWhitespace.foreground": "#212120",
    "editorIndentGuide.background1": "#212120",
    "editorIndentGuide.activeBackground1": "#575547",
    "editorBracketMatch.background": "#393830",
    "editorBracketMatch.border": "#e3a138",
    "editorError.foreground": "#d0654b",
    "editorWarning.foreground": "#e3a138",
    "editorInfo.foreground": "#799173",
    "editorHint.foreground": "#c6aa77",
    "editorGutter.addedBackground": "#7e7b4c",
    "editorGutter.modifiedBackground": "#d2a860",
    "editorGutter.deletedBackground": "#b5412c",
    "editorSuggestWidget.background": "#131312",
    "editorSuggestWidget.selectedBackground": "#393830",
    "editorHoverWidget.background": "#131312",
    "editorWidget.background": "#131312",
    "sideBar.background": "#131312",
    "sideBarSectionHeader.background": "#1e1d1d",
    "activityBar.background": "#131312",
    "activityBar.foreground": "#e3ca9a",
    "statusBar.background": "#131312",
    "statusBar.foreground": "#e3ca9a",
    "titleBar.activeBackground": "#131312",
    "titleBar.activeForeground": "#e3ca9a",
    "tab.activeBackground": "#1e1d1d",
    "tab.inactiveBackground": "#131312",
    "tab.activeBorderTop": "#e3a138",
    "panel.background": "#1e1d1d",
    "terminal.background": "#1e1d1d",
    "terminal.foreground": "#e3ca9a",
    "list.activeSelectionBackground": "#393830",
    "list.hoverBackground": "#212120",
    "input.background": "#131312",
    "dropdown.background": "#131312",
    "focusBorder": "#e3a138"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#6c6b58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#979764"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#979764"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#d0654b"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#d97e4a"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#d97e4a"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#d97e4a"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#d97e4a"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#d97e4a"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#c48b6d"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#c48b6d"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#cfa351",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#e3ca9a",
    "variable.readonly": "#cfa351",
    "parameter": {
      "foreground": "#979764",
      "fontStyle": "italic"
    },
    "property": "#e3ca9a",
    "enumMember": "#cfa351",
    "function": "#848a68",
    "type": {
      "foreground": "#e3a138",
      "fontStyle": "italic"
    },
    "class": "#e3a138",
    "namespace": "#799173",
    "struct": {
      "foreground": "#e3a138",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#e3a138",
      "fontStyle": "italic"
    },
    "operator": "#c48b6d"
  }
}
