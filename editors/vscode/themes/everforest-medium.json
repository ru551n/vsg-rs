{
  "name": "Everforest VHDL Medium",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#2d353b",
    "editor.foreground": "#d3c6aa",
    "editorCursor.foreground": "#d3c6aa",
    "editor.selectionBackground": "#543a48",
    "editor.lineHighlightBackground": "#343f44",
    "editorLineNumber.foreground": "#56635f",
    "editorLineNumber.activeForeground": "#a7c080",
    "editorWhitespace.foreground": "#343f44",
    "editorIndentGuide.background1": "#343f44",
    "editorIndentGuide.activeBackground1": "#56635f",
    "editorBracketMatch.background": "#543a48",
    "editorBracketMatch.border": "#a7c080",
    "editorError.foreground": "#e67e80",
    "editorWarning.foreground": "#dbbc7f",
    "editorInfo.foreground": "#7fbbb3",
    "editorHint.foreground": "#9da9a0",
    "editorGutter.addedBackground": "#a7c080",
    "editorGutter.modifiedBackground": "#7fbbb3",
    "editorGutter.deletedBackground": "#e67e80",
    "editorSuggestWidget.background": "#232a2e",
    "editorSuggestWidget.selectedBackground": "#543a48",
    "editorHoverWidget.background": "#232a2e",
    "editorWidget.background": "#232a2e",
    "sideBar.background": "#232a2e",
    "sideBarSectionHeader.background": "#2d353b",
    "activityBar.background": "#232a2e",
    "activityBar.foreground": "#d3c6aa",
    "statusBar.background": "#232a2e",
    "statusBar.foreground": "#d3c6aa",
    "titleBar.activeBackground": "#232a2e",
    "titleBar.activeForeground": "#d3c6aa",
    "tab.activeBackground": "#2d353b",
    "tab.inactiveBackground": "#232a2e",
    "tab.activeBorderTop": "#a7c080",
    "panel.background": "#2d353b",
    "terminal.background": "#2d353b",
    "terminal.foreground": "#d3c6aa",
    "list.activeSelectionBackground": "#543a48",
    "list.hoverBackground": "#343f44",
    "input.background": "#232a2e",
    "dropdown.background": "#232a2e",
    "focusBorder": "#a7c080"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#859289",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#a7c080"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#a7c080"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#dbbc7f"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#d699b6"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#e69875"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#e69875"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#d699b6",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#d3c6aa",
    "variable.readonly": "#83c092",
    "parameter": {
      "foreground": "#7fbbb3",
      "fontStyle": "italic"
    },
    "property": "#83c092",
    "enumMember": "#83c092",
    "function": "#a7c080",
    "type": {
      "foreground": "#dbbc7f",
      "fontStyle": "italic"
    },
    "class": "#dbbc7f",
    "namespace": "#d699b6",
    "struct": {
      "foreground": "#dbbc7f",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#dbbc7f",
      "fontStyle": "italic"
    },
    "operator": "#e69875"
  }
}
