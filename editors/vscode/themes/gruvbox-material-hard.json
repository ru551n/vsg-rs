{
  "name": "Gruvbox Material VHDL Hard",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1d2021",
    "editor.foreground": "#d4be98",
    "editorCursor.foreground": "#d4be98",
    "editor.selectionBackground": "#3c3836",
    "editor.lineHighlightBackground": "#282828",
    "editorLineNumber.foreground": "#504945",
    "editorLineNumber.activeForeground": "#a9b665",
    "editorWhitespace.foreground": "#282828",
    "editorIndentGuide.background1": "#282828",
    "editorIndentGuide.activeBackground1": "#504945",
    "editorBracketMatch.background": "#3c3836",
    "editorBracketMatch.border": "#a9b665",
    "editorError.foreground": "#ea6962",
    "editorWarning.foreground": "#d8a657",
    "editorInfo.foreground": "#7daea3",
    "editorHint.foreground": "#a89984",
    "editorGutter.addedBackground": "#a9b665",
    "editorGutter.modifiedBackground": "#7daea3",
    "editorGutter.deletedBackground": "#ea6962",
    "editorSuggestWidget.background": "#141617",
    "editorSuggestWidget.selectedBackground": "#3c3836",
    "editorHoverWidget.background": "#141617",
    "editorWidget.background": "#141617",
    "sideBar.background": "#141617",
    "sideBarSectionHeader.background": "#1d2021",
    "activityBar.background": "#141617",
    "activityBar.foreground": "#d4be98",
    "statusBar.background": "#141617",
    "statusBar.foreground": "#d4be98",
    "titleBar.activeBackground": "#141617",
    "titleBar.activeForeground": "#d4be98",
    "tab.activeBackground": "#1d2021",
    "tab.inactiveBackground": "#141617",
    "tab.activeBorderTop": "#a9b665",
    "panel.background": "#1d2021",
    "terminal.background": "#1d2021",
    "terminal.foreground": "#d4be98",
    "list.activeSelectionBackground": "#3c3836",
    "list.hoverBackground": "#282828",
    "input.background": "#141617",
    "dropdown.background": "#141617",
    "focusBorder": "#a9b665"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#d8a657"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#d4be98",
    "variable.readonly": "#89b482",
    "parameter": {
      "foreground": "#7daea3",
      "fontStyle": "italic"
    },
    "property": "#89b482",
    "enumMember": "#89b482",
    "function": "#a9b665",
    "type": {
      "foreground": "#d8a657",
      "fontStyle": "italic"
    },
    "class": "#d8a657",
    "namespace": "#d3869b",
    "struct": {
      "foreground": "#d8a657",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#d8a657",
      "fontStyle": "italic"
    },
    "operator": "#e78a4e"
  }
}
