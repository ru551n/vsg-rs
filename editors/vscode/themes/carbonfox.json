{
  "name": "Carbonfox VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#161616",
    "editor.foreground": "#f2f4f8",
    "editorCursor.foreground": "#f2f4f8",
    "editor.selectionBackground": "#2a2a2a",
    "editor.lineHighlightBackground": "#353535",
    "editorLineNumber.foreground": "#7b7c7e",
    "editorLineNumber.activeForeground": "#8cb6ff",
    "editorWhitespace.foreground": "#353535",
    "editorIndentGuide.background1": "#353535",
    "editorIndentGuide.activeBackground1": "#7b7c7e",
    "editorBracketMatch.background": "#2a2a2a",
    "editorBracketMatch.border": "#8cb6ff",
    "editorError.foreground": "#ee5396",
    "editorWarning.foreground": "#08bdba",
    "editorInfo.foreground": "#78a9ff",
    "editorHint.foreground": "#b6b8bb",
    "editorGutter.addedBackground": "#25be6a",
    "editorGutter.modifiedBackground": "#78a9ff",
    "editorGutter.deletedBackground": "#ee5396",
    "editorSuggestWidget.background": "#0c0c0c",
    "editorSuggestWidget.selectedBackground": "#2a2a2a",
    "editorHoverWidget.background": "#0c0c0c",
    "editorWidget.background": "#0c0c0c",
    "sideBar.background": "#0c0c0c",
    "sideBarSectionHeader.background": "#161616",
    "activityBar.background": "#0c0c0c",
    "activityBar.foreground": "#f2f4f8",
    "statusBar.background": "#0c0c0c",
    "statusBar.foreground": "#f2f4f8",
    "titleBar.activeBackground": "#0c0c0c",
    "titleBar.activeForeground": "#f2f4f8",
    "tab.activeBackground": "#161616",
    "tab.inactiveBackground": "#0c0c0c",
    "tab.activeBorderTop": "#8cb6ff",
    "panel.background": "#161616",
    "terminal.background": "#161616",
    "terminal.foreground": "#f2f4f8",
    "list.activeSelectionBackground": "#2a2a2a",
    "list.hoverBackground": "#353535",
    "input.background": "#0c0c0c",
    "dropdown.background": "#0c0c0c",
    "focusBorder": "#8cb6ff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#6e6f70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#25be6a"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#25be6a"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#2dc7c4"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#3ddbd9"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#be95ff"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#be95ff"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#be95ff"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#be95ff"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#b6b8bb"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#b6b8bb"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#ff91c1",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#f2f4f8",
    "variable.readonly": "#5ae0df",
    "parameter": {
      "foreground": "#33b1ff",
      "fontStyle": "italic"
    },
    "property": "#78a9ff",
    "enumMember": "#5ae0df",
    "function": "#8cb6ff",
    "type": {
      "foreground": "#08bdba",
      "fontStyle": "italic"
    },
    "class": "#08bdba",
    "namespace": "#52bdff",
    "struct": {
      "foreground": "#08bdba",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#08bdba",
      "fontStyle": "italic"
    },
    "operator": "#b6b8bb"
  }
}
