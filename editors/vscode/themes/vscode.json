{
  "name": "VS Code Dark+ VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1f1f1f",
    "editor.foreground": "#d4d4d4",
    "editorCursor.foreground": "#d4d4d4",
    "editor.selectionBackground": "#264f78",
    "editor.lineHighlightBackground": "#222222",
    "editorLineNumber.foreground": "#5a5a5a",
    "editorLineNumber.activeForeground": "#569cd6",
    "editorWhitespace.foreground": "#222222",
    "editorIndentGuide.background1": "#222222",
    "editorIndentGuide.activeBackground1": "#5a5a5a",
    "editorBracketMatch.background": "#264f78",
    "editorBracketMatch.border": "#569cd6",
    "editorError.foreground": "#f44747",
    "editorWarning.foreground": "#d7ba7d",
    "editorInfo.foreground": "#569cd6",
    "editorHint.foreground": "#808080",
    "editorGutter.addedBackground": "#81b88b",
    "editorGutter.modifiedBackground": "#e2c08d",
    "editorGutter.deletedBackground": "#c74e39",
    "editorSuggestWidget.background": "#252526",
    "editorSuggestWidget.selectedBackground": "#264f78",
    "editorHoverWidget.background": "#252526",
    "editorWidget.background": "#252526",
    "sideBar.background": "#252526",
    "sideBarSectionHeader.background": "#1f1f1f",
    "activityBar.background": "#252526",
    "activityBar.foreground": "#d4d4d4",
    "statusBar.background": "#252526",
    "statusBar.foreground": "#d4d4d4",
    "titleBar.activeBackground": "#252526",
    "titleBar.activeForeground": "#d4d4d4",
    "tab.activeBackground": "#1f1f1f",
    "tab.inactiveBackground": "#252526",
    "tab.activeBorderTop": "#569cd6",
    "panel.background": "#1f1f1f",
    "terminal.background": "#1f1f1f",
    "terminal.foreground": "#d4d4d4",
    "list.activeSelectionBackground": "#264f78",
    "list.hoverBackground": "#222222",
    "input.background": "#252526",
    "dropdown.background": "#252526",
    "focusBorder": "#569cd6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#6a9955",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#dcdcaa",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#d4d4d4",
    "variable.readonly": "#4fc1ff",
    "parameter": {
      "foreground": "#9cdcfe",
      "fontStyle": "italic"
    },
    "property": "#9cdcfe",
    "enumMember": "#4fc1ff",
    "function": "#dcdcaa",
    "type": {
      "foreground": "#4ec9b0",
      "fontStyle": "italic"
    },
    "class": "#4ec9b0",
    "namespace": "#4ec9b0",
    "struct": {
      "foreground": "#4ec9b0",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#4ec9b0",
      "fontStyle": "italic"
    },
    "operator": "#d4d4d4"
  }
}
