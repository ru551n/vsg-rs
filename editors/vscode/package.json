{
  "name": "vsg-rs",
  "displayName": "vsg-rs: VHDL formatter and static analysis",
  "description": "VHDL for VS Code: formatting and static analysis from the vsg-rs language server, plus syntax highlighting and editing actions such as instantiating an entity, declaring port map signals and generating a state machine.",
  "version": "0.11.1",
  "publisher": "ru551n",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ru551n/vsg-rs.git",
    "directory": "editors/vscode"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "vhdl",
    "fpga",
    "formatter",
    "linter",
    "vsg",
    "instantiate",
    "fsm"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:vhdl",
    "onView:vsg-rs.hierarchy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL"
        ],
        "extensions": [
          ".vhd",
          ".vhdl",
          ".vho",
          ".vht"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "vsg-rs",
      "properties": {
        "vsg-rs.server.mode": {
          "type": "string",
          "enum": [
            "embedded",
            "systemPath",
            "userPath"
          ],
          "enumDescriptions": [
            "Use the server bundled with this extension.",
            "Run `vsg-rs` from PATH.",
            "Run the executable named by vsg-rs.server.path."
          ],
          "default": "embedded",
          "description": "Which vsg-rs executable to run."
        },
        "vsg-rs.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a vsg-rs executable, used when vsg-rs.server.mode is userPath. Point this at target/debug/vsg-rs to test a local build."
        },
        "vsg-rs.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the server to the vsg-rs output channel."
        },
        "vsg-rs.waiverFile": {
          "type": "string",
          "default": "vsg-rs-waivers.yaml",
          "markdownDescription": "What a waiver file is called. The server looks for one beside the file being checked and in each directory above it, and creates one at the workspace root when the project has none. Pass the same file to the command line with `--waivers` so the editor and CI agree about what has been accepted."
        }
      }
    },
    "commands": [
      {
        "command": "vsg-rs.restartServer",
        "title": "Restart Server",
        "category": "vsg-rs"
      },
      {
        "command": "vsg-rs.showOutput",
        "title": "Show Output",
        "category": "vsg-rs"
      },
      {
        "command": "vsg-rs.showVersion",
        "title": "Show Server Version",
        "category": "vsg-rs"
      },
      {
        "command": "vsg-rs.waiveWithReason",
        "title": "Waive a Finding...",
        "category": "vsg-rs",
        "enablement": "false"
      },
      {
        "command": "vsg-rs.instantiateEntity",
        "title": "VHDL: Instantiate Entity",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.declareSignals",
        "title": "VHDL: Declare Signals for Port Map",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.fsmFromEnum",
        "title": "VHDL: Create State Machine from Enum Type",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.addUseClause",
        "title": "VHDL: Add Library and Use Clause for Symbol",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.componentDeclaration",
        "title": "VHDL: Declare Entity as Component",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.removeUnusedUseClauses",
        "title": "VHDL: Remove Unused Use Clauses",
        "category": "VHDL"
      },
      {
        "command": "vsg-rs.refreshHierarchy",
        "title": "Refresh",
        "category": "VHDL",
        "icon": "$(refresh)"
      },
      {
        "command": "vsg-rs.extractObject",
        "title": "VHDL: Extract Selection to Constant or Signal",
        "category": "VHDL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == vhdl",
          "command": "vsg-rs.instantiateEntity",
          "group": "1_modification@1"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "vsg-rs.declareSignals",
          "group": "1_modification@2"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "vsg-rs.fsmFromEnum",
          "group": "1_modification@3"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "vsg-rs.addUseClause",
          "group": "1_modification@4"
        },
        {
          "when": "editorLangId == vhdl",
          "command": "vsg-rs.componentDeclaration",
          "group": "1_modification@5"
        }
      ],
      "view/title": [
        {
          "command": "vsg-rs.refreshHierarchy",
          "when": "view == vsg-rs.hierarchy",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vsg-rs.refreshHierarchy",
          "when": "false"
        }
      ]
    },
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Gruvbox VHDL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/gruvbox-vhdl-dark.json"
      },
      {
        "label": "Gruvbox VHDL Light",
        "uiTheme": "vs",
        "path": "./themes/gruvbox-vhdl-light.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vsg-rs.hierarchy",
          "name": "VHDL Design",
          "when": "vsg-rs.hasVhdl"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node scripts/package.mjs",
    "test": "node --experimental-strip-types src/generate.test.ts && node scripts/check-grammar.mjs",
    "smoke": "node test/smoke/run.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
