{
  "name": "Catppuccin VHDL Mocha",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editorCursor.foreground": "#cdd6f4",
    "editor.selectionBackground": "#45475a",
    "editor.lineHighlightBackground": "#313244",
    "editorLineNumber.foreground": "#45475a",
    "editorLineNumber.activeForeground": "#cba6f7",
    "editorWhitespace.foreground": "#313244",
    "editorIndentGuide.background1": "#313244",
    "editorIndentGuide.activeBackground1": "#45475a",
    "editorBracketMatch.background": "#45475a",
    "editorBracketMatch.border": "#cba6f7",
    "editorError.foreground": "#f38ba8",
    "editorWarning.foreground": "#f9e2af",
    "editorInfo.foreground": "#89dceb",
    "editorHint.foreground": "#7f849c",
    "editorGutter.addedBackground": "#a6e3a1",
    "editorGutter.modifiedBackground": "#f9e2af",
    "editorGutter.deletedBackground": "#f38ba8",
    "editorSuggestWidget.background": "#181825",
    "editorSuggestWidget.selectedBackground": "#45475a",
    "editorHoverWidget.background": "#181825",
    "editorWidget.background": "#181825",
    "sideBar.background": "#181825",
    "sideBarSectionHeader.background": "#1e1e2e",
    "activityBar.background": "#181825",
    "activityBar.foreground": "#cdd6f4",
    "statusBar.background": "#181825",
    "statusBar.foreground": "#cdd6f4",
    "titleBar.activeBackground": "#181825",
    "titleBar.activeForeground": "#cdd6f4",
    "tab.activeBackground": "#1e1e2e",
    "tab.inactiveBackground": "#181825",
    "tab.activeBorderTop": "#cba6f7",
    "panel.background": "#1e1e2e",
    "terminal.background": "#1e1e2e",
    "terminal.foreground": "#cdd6f4",
    "list.activeSelectionBackground": "#45475a",
    "list.hoverBackground": "#313244",
    "input.background": "#181825",
    "dropdown.background": "#181825",
    "focusBorder": "#cba6f7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#fab387",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#cdd6f4",
    "variable.readonly": "#fab387",
    "parameter": {
      "foreground": "#eba0ac",
      "fontStyle": "italic"
    },
    "property": "#b4befe",
    "enumMember": "#fab387",
    "function": "#89b4fa",
    "type": {
      "foreground": "#f9e2af",
      "fontStyle": "italic"
    },
    "class": "#f9e2af",
    "namespace": "#f9e2af",
    "struct": {
      "foreground": "#f9e2af",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#f9e2af",
      "fontStyle": "italic"
    },
    "operator": "#89dceb"
  }
}
