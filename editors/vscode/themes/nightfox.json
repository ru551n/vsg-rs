{
  "name": "Nightfox VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#192330",
    "editor.foreground": "#cdcecf",
    "editorCursor.foreground": "#cdcecf",
    "editor.selectionBackground": "#2b3b51",
    "editor.lineHighlightBackground": "#29394f",
    "editorLineNumber.foreground": "#71839b",
    "editorLineNumber.activeForeground": "#86abdc",
    "editorWhitespace.foreground": "#29394f",
    "editorIndentGuide.background1": "#29394f",
    "editorIndentGuide.activeBackground1": "#71839b",
    "editorBracketMatch.background": "#2b3b51",
    "editorBracketMatch.border": "#86abdc",
    "editorError.foreground": "#c94f6d",
    "editorWarning.foreground": "#dbc074",
    "editorInfo.foreground": "#719cd6",
    "editorHint.foreground": "#aeafb0",
    "editorGutter.addedBackground": "#81b29a",
    "editorGutter.modifiedBackground": "#719cd6",
    "editorGutter.deletedBackground": "#c94f6d",
    "editorSuggestWidget.background": "#131a24",
    "editorSuggestWidget.selectedBackground": "#2b3b51",
    "editorHoverWidget.background": "#131a24",
    "editorWidget.background": "#131a24",
    "sideBar.background": "#131a24",
    "sideBarSectionHeader.background": "#192330",
    "activityBar.background": "#131a24",
    "activityBar.foreground": "#cdcecf",
    "statusBar.background": "#131a24",
    "statusBar.foreground": "#cdcecf",
    "titleBar.activeBackground": "#131a24",
    "titleBar.activeForeground": "#cdcecf",
    "tab.activeBackground": "#192330",
    "tab.inactiveBackground": "#131a24",
    "tab.activeBorderTop": "#86abdc",
    "panel.background": "#192330",
    "terminal.background": "#192330",
    "terminal.foreground": "#cdcecf",
    "list.activeSelectionBackground": "#2b3b51",
    "list.hoverBackground": "#29394f",
    "input.background": "#131a24",
    "dropdown.background": "#131a24",
    "focusBorder": "#86abdc"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#738091",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#81b29a"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#81b29a"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#e0c989"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#f4a261"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#9d79d6"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#9d79d6"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#9d79d6"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#9d79d6"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#aeafb0"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#aeafb0"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#dc8ed9",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#cdcecf",
    "variable.readonly": "#f6b079",
    "parameter": {
      "foreground": "#63cdcf",
      "fontStyle": "italic"
    },
    "property": "#719cd6",
    "enumMember": "#f6b079",
    "function": "#86abdc",
    "type": {
      "foreground": "#dbc074",
      "fontStyle": "italic"
    },
    "class": "#dbc074",
    "namespace": "#7ad5d6",
    "struct": {
      "foreground": "#dbc074",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#dbc074",
      "fontStyle": "italic"
    },
    "operator": "#aeafb0"
  }
}
