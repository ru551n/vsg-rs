{
  "name": "Vague VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#141415",
    "editor.foreground": "#cdcdcd",
    "editorCursor.foreground": "#cdcdcd",
    "editor.selectionBackground": "#333738",
    "editor.lineHighlightBackground": "#252530",
    "editorLineNumber.foreground": "#606079",
    "editorLineNumber.activeForeground": "#6e94b2",
    "editorWhitespace.foreground": "#252530",
    "editorIndentGuide.background1": "#252530",
    "editorIndentGuide.activeBackground1": "#606079",
    "editorBracketMatch.background": "#333738",
    "editorBracketMatch.border": "#6e94b2",
    "editorError.foreground": "#d8647e",
    "editorWarning.foreground": "#f3be7c",
    "editorInfo.foreground": "#7e98e8",
    "editorHint.foreground": "#878787",
    "editorGutter.addedBackground": "#7fa563",
    "editorGutter.modifiedBackground": "#f3be7c",
    "editorGutter.deletedBackground": "#d8647e",
    "editorSuggestWidget.background": "#1c1c24",
    "editorSuggestWidget.selectedBackground": "#333738",
    "editorHoverWidget.background": "#1c1c24",
    "editorWidget.background": "#1c1c24",
    "sideBar.background": "#1c1c24",
    "sideBarSectionHeader.background": "#141415",
    "activityBar.background": "#1c1c24",
    "activityBar.foreground": "#cdcdcd",
    "statusBar.background": "#1c1c24",
    "statusBar.foreground": "#cdcdcd",
    "titleBar.activeBackground": "#1c1c24",
    "titleBar.activeForeground": "#cdcdcd",
    "tab.activeBackground": "#141415",
    "tab.inactiveBackground": "#1c1c24",
    "tab.activeBorderTop": "#6e94b2",
    "panel.background": "#141415",
    "terminal.background": "#141415",
    "terminal.foreground": "#cdcdcd",
    "list.activeSelectionBackground": "#333738",
    "list.hoverBackground": "#252530",
    "input.background": "#1c1c24",
    "dropdown.background": "#1c1c24",
    "focusBorder": "#6e94b2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#606079",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#e8b589"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#e8b589"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#e0a363"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#90a0b5"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#90a0b5"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#6e94b2",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#cdcdcd",
    "variable.readonly": "#aeaed1",
    "parameter": {
      "foreground": "#bb9dbd",
      "fontStyle": "italic"
    },
    "property": "#b4d4cf",
    "enumMember": "#aeaed1",
    "function": "#c48282",
    "type": {
      "foreground": "#9bb4bc",
      "fontStyle": "italic"
    },
    "class": "#9bb4bc",
    "namespace": "#aeaed1",
    "struct": {
      "foreground": "#9bb4bc",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#9bb4bc",
      "fontStyle": "italic"
    },
    "operator": "#90a0b5"
  }
}
