{
  "name": "Luna VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#060606",
    "editor.foreground": "#e4e4e8",
    "editorCursor.foreground": "#e4e4e8",
    "editor.selectionBackground": "#384048",
    "editor.lineHighlightBackground": "#212121",
    "editorLineNumber.foreground": "#605958",
    "editorLineNumber.activeForeground": "#75a1c7",
    "editorWhitespace.foreground": "#212121",
    "editorIndentGuide.background1": "#212121",
    "editorIndentGuide.activeBackground1": "#605958",
    "editorBracketMatch.background": "#384048",
    "editorBracketMatch.border": "#75a1c7",
    "editorError.foreground": "#e08585",
    "editorWarning.foreground": "#d9a35a",
    "editorInfo.foreground": "#8c9cb8",
    "editorHint.foreground": "#a8a8a8",
    "editorGutter.addedBackground": "#6fbe80",
    "editorGutter.modifiedBackground": "#c2916a",
    "editorGutter.deletedBackground": "#e08585",
    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.selectedBackground": "#384048",
    "editorHoverWidget.background": "#000000",
    "editorWidget.background": "#000000",
    "sideBar.background": "#000000",
    "sideBarSectionHeader.background": "#060606",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#e4e4e8",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#e4e4e8",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#e4e4e8",
    "tab.activeBackground": "#060606",
    "tab.inactiveBackground": "#000000",
    "tab.activeBorderTop": "#75a1c7",
    "panel.background": "#060606",
    "terminal.background": "#060606",
    "terminal.foreground": "#e4e4e8",
    "list.activeSelectionBackground": "#384048",
    "list.hoverBackground": "#212121",
    "input.background": "#000000",
    "dropdown.background": "#000000",
    "focusBorder": "#75a1c7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#7c7c7c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#9eb38e"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#9eb38e"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#c2916a"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#e19067"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#e19067"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#e19067"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#e19067"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#e19067"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#c2916a",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#e4e4e8",
    "variable.readonly": "#c4a8d6",
    "parameter": {
      "foreground": "#f0e0d6",
      "fontStyle": "italic"
    },
    "property": "#c7c7c7",
    "enumMember": "#c4a8d6",
    "function": "#75a1c7",
    "type": {
      "foreground": "#c4a8d6",
      "fontStyle": "italic"
    },
    "class": "#c4a8d6",
    "namespace": "#989898",
    "struct": {
      "foreground": "#c4a8d6",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#c4a8d6",
      "fontStyle": "italic"
    },
    "operator": "#a8a8a8"
  }
}
