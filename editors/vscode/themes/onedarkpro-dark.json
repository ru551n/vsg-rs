{
  "name": "One Dark Pro VHDL Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#abb2bf",
    "editorCursor.foreground": "#abb2bf",
    "editor.selectionBackground": "#212121",
    "editor.lineHighlightBackground": "#171717",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#61afef",
    "editorWhitespace.foreground": "#171717",
    "editorIndentGuide.background1": "#171717",
    "editorIndentGuide.activeBackground1": "#495162",
    "editorBracketMatch.background": "#212121",
    "editorBracketMatch.border": "#61afef",
    "editorError.foreground": "#ef596f",
    "editorWarning.foreground": "#e5c07b",
    "editorInfo.foreground": "#61afef",
    "editorHint.foreground": "#7f848e",
    "editorGutter.addedBackground": "#89ca78",
    "editorGutter.modifiedBackground": "#e5c07b",
    "editorGutter.deletedBackground": "#ef596f",
    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.selectedBackground": "#212121",
    "editorHoverWidget.background": "#000000",
    "editorWidget.background": "#000000",
    "sideBar.background": "#000000",
    "sideBarSectionHeader.background": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#abb2bf",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#abb2bf",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#abb2bf",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.activeBorderTop": "#61afef",
    "panel.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#abb2bf",
    "list.activeSelectionBackground": "#212121",
    "list.hoverBackground": "#171717",
    "input.background": "#000000",
    "dropdown.background": "#000000",
    "focusBorder": "#61afef"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#7f848e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#89ca78"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#89ca78"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#2bbac5"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#d55fde"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#d55fde"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#d55fde"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#d55fde"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#2bbac5"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#2bbac5"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#d55fde",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#abb2bf",
    "variable.readonly": "#d19a66",
    "parameter": {
      "foreground": "#ef596f",
      "fontStyle": "italic"
    },
    "property": "#ef596f",
    "enumMember": "#d19a66",
    "function": "#61afef",
    "type": {
      "foreground": "#e5c07b",
      "fontStyle": "italic"
    },
    "class": "#e5c07b",
    "namespace": "#e5c07b",
    "struct": {
      "foreground": "#e5c07b",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#e5c07b",
      "fontStyle": "italic"
    },
    "operator": "#2bbac5"
  }
}
