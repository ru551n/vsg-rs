{
  "name": "Tender VHDL",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#282828",
    "editor.foreground": "#eeeeee",
    "editorCursor.foreground": "#eeeeee",
    "editor.selectionBackground": "#293b44",
    "editor.lineHighlightBackground": "#323232",
    "editorLineNumber.foreground": "#444444",
    "editorLineNumber.activeForeground": "#73cef4",
    "editorWhitespace.foreground": "#323232",
    "editorIndentGuide.background1": "#323232",
    "editorIndentGuide.activeBackground1": "#444444",
    "editorBracketMatch.background": "#293b44",
    "editorBracketMatch.border": "#73cef4",
    "editorError.foreground": "#f43753",
    "editorWarning.foreground": "#d3b987",
    "editorInfo.foreground": "#73cef4",
    "editorHint.foreground": "#999999",
    "editorGutter.addedBackground": "#c9d05c",
    "editorGutter.modifiedBackground": "#b3deef",
    "editorGutter.deletedBackground": "#f43753",
    "editorSuggestWidget.background": "#1d1d1d",
    "editorSuggestWidget.selectedBackground": "#293b44",
    "editorHoverWidget.background": "#1d1d1d",
    "editorWidget.background": "#1d1d1d",
    "sideBar.background": "#1d1d1d",
    "sideBarSectionHeader.background": "#282828",
    "activityBar.background": "#1d1d1d",
    "activityBar.foreground": "#eeeeee",
    "statusBar.background": "#1d1d1d",
    "statusBar.foreground": "#eeeeee",
    "titleBar.activeBackground": "#1d1d1d",
    "titleBar.activeForeground": "#eeeeee",
    "tab.activeBackground": "#282828",
    "tab.inactiveBackground": "#1d1d1d",
    "tab.activeBorderTop": "#73cef4",
    "panel.background": "#282828",
    "terminal.background": "#282828",
    "terminal.foreground": "#eeeeee",
    "list.activeSelectionBackground": "#293b44",
    "list.hoverBackground": "#323232",
    "input.background": "#1d1d1d",
    "dropdown.background": "#1d1d1d",
    "focusBorder": "#73cef4"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line.double-dash.vhdl",
        "comment.block.vhdl"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted.double.vhdl",
      "settings": {
        "foreground": "#d3b987"
      }
    },
    {
      "scope": "constant.character.vhdl",
      "settings": {
        "foreground": "#d3b987"
      }
    },
    {
      "scope": "constant.character.escape.vhdl",
      "settings": {
        "foreground": "#73cef4"
      }
    },
    {
      "scope": [
        "constant.numeric.decimal.vhdl",
        "constant.numeric.based.vhdl",
        "constant.numeric.bit-string.vhdl"
      ],
      "settings": {
        "foreground": "#ffc24b"
      }
    },
    {
      "scope": "keyword.control.vhdl",
      "settings": {
        "foreground": "#73cef4"
      }
    },
    {
      "scope": "keyword.other.vhdl",
      "settings": {
        "foreground": "#73cef4"
      }
    },
    {
      "scope": "storage.type.vhdl",
      "settings": {
        "foreground": "#73cef4"
      }
    },
    {
      "scope": "keyword.operator.word.vhdl",
      "settings": {
        "foreground": "#73cef4"
      }
    },
    {
      "scope": [
        "keyword.operator.comparison.vhdl",
        "keyword.operator.arithmetic.vhdl"
      ],
      "settings": {
        "foreground": "#f43753"
      }
    },
    {
      "scope": "keyword.operator.assignment.vhdl",
      "settings": {
        "foreground": "#f43753"
      }
    },
    {
      "scope": "support.other.attribute.vhdl",
      "settings": {
        "foreground": "#c9d05c",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#eeeeee",
    "variable.readonly": "#ffc24b",
    "parameter": {
      "foreground": "#c9d05c",
      "fontStyle": "italic"
    },
    "property": "#dadada",
    "enumMember": "#ffc24b",
    "function": "#b3deef",
    "type": {
      "foreground": "#73cef4",
      "fontStyle": "italic"
    },
    "class": "#73cef4",
    "namespace": "#9faa00",
    "struct": {
      "foreground": "#73cef4",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#73cef4",
      "fontStyle": "italic"
    },
    "operator": "#f43753"
  }
}
